{
  "name": "aibitat",
  "version": "0.0.4",
  "description": "An extensible, stateless and customizable framework for multi-agents conversation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wladiston/aibitat.git"
  },
  "author": {
    "name": "Wlad Paiva",
    "email": "desenvolvedormg@gmail.com"
  },
  "bin": "src/cli.ts",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.js",
      "types": "./src/plugins/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "format": "prettier --write .",
    "prepare": "is-ci || husky install",
    "typecheck": "tsc --noEmit",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.1.0",
    "cheerio": "^1.0.0",
    "bun-types": "latest",
    "husky": "^8.0.0",
    "is-ci": "^3.0.1",
    "nano-staged": "^0.8.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@inquirer/prompts": "^3.2.0",
    "@langchain/core": "^0.3.80",
    "@langchain/openai": "^0.6.17",
    "chalk": "^5.3.0",
    "langchain": "^0.3.37",
    "node-html-markdown": "^1.3.0",
    "openai": "^4.11.1"
  },
  "overrides": {
    "argparse": "3.0.2",
    "@babel/core": "7.29.6",
    "@babel/helpers": "7.29.2",
    "@babel/runtime": "7.26.10",
    "@babel/traverse": "7.29.0",
    "browserslist": "4.28.7",
    "braces": "3.0.3",
    "cross-spawn": "6.0.6",
    "form-data": "4.0.6",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "langsmith": "0.8.0",
    "micromatch": "4.0.8",
    "picomatch": "2.3.2",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "yaml": "2.8.3"
  },
  "nano-staged": {
    "*.{js,jsx,json,yml,yaml,css,ts,tsx,md,mdx}": "prettier --write"
  }
}
